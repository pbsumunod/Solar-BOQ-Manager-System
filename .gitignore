# Secrets
.env
credentials.json
token.json
.streamlit/secrets.toml

# Temporary/regeneratable files
.tmp/*
!.tmp/.gitkeep

# Durable local app data (e.g. BOQ project files) — NOT disposable, unlike
# .tmp/. Gitignored because Excel binaries don't diff usefully and this may
# contain client pricing. Not regenerated by any tool — back up manually.
data/projects/*.xlsx
!data/projects/.gitkeep
data/materials_catalog.xlsx

# Source pricing workbook (business/supplier pricing) — same rationale as data/.
PACKAGES.xlsx

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store

# Excel lock files
~$*.xlsx
