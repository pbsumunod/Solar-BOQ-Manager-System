# Copy this file to .streamlit/secrets.toml for local testing (that file is
# gitignored -- never commit real secrets). For deployment, paste this same
# content into the app's Secrets in Streamlit Community Cloud's dashboard
# instead of committing it anywhere.
#
# Everything here is generated for you by running:
#   .venv/bin/python tools/setup_google_auth.py
# which prints a ready-to-paste block with real values filled in.
#
# Leaving this whole file's content out entirely (no secrets.toml, and no
# secrets configured in Streamlit Cloud) is also valid -- the app falls back
# to local Excel-file storage with no password gate, which is what running
# it locally without any of this setup gives you.

# The shared password everyone uses to open the app. Leave this line out
# entirely to disable the password gate (e.g. while testing locally).
app_password = "choose-a-shared-password"

# OAuth refresh token for a real Google account (not a service account --
# service accounts have their own Drive storage quota issues). Generated by
# tools/setup_google_auth.py.
[google_oauth]
refresh_token = "..."
client_id = "...apps.googleusercontent.com"
client_secret = "..."

# IDs of the Drive folder (holds one Spreadsheet per project) and the
# Materials Catalog spreadsheet, both also printed by setup_google_auth.py.
[boq]
projects_folder_id = "..."
catalog_spreadsheet_id = "..."
